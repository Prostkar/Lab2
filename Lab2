// ===================== ConsoleApp1 =====================
namespace Lab2.Task1
{

    class Program
    {
        static string GetMonthName(int n)
        {
            switch (n)
            {
                case 1: return "січень";
                case 2: return "лютий";
                case 3: return "березень";
                case 4: return "квітень";
                case 5: return "травень";
                case 6: return "червень";
                case 7: return "липень";
                case 8: return "серпень";
                case 9: return "вересень";
                case 10: return "жовтень";
                case 11: return "листопад";
                case 12: return "грудень";
                default: return null;
            }
        }

        // Запитує, чи повторити програму
        static bool AskRepeat()
        {
            while (true)
            {
                Console.Write("\nПовторити? (т - так, н - ні): ");
                string s = (Console.ReadLine() ?? "").Trim().ToLower();
                if (s == "т" || s == "y" || s == "так") return true;
                if (s == "н" || s == "n" || s == "ні") return false;
                Console.WriteLine("Введіть 'т' або 'н'.");
            }
        }

        public static void Run()
        {
            Console.OutputEncoding = Encoding.UTF8;
            Console.InputEncoding = Encoding.UTF8;

            do
            {
                Console.Write("Введіть порядковий номер місяця (1-12): ");

                if (!int.TryParse(Console.ReadLine(), out int n))
                {
                    Console.WriteLine("Помилка: потрібно ввести ціле число.");
                }
                else
                {
                    string name = GetMonthName(n);
                    if (name == null)
                        Console.WriteLine("Помилка: номер місяця має бути в діапазоні від 1 до 12.");
                    else
                        Console.WriteLine($"Місяць №{n} - {name}");
                }
            } while (AskRepeat());
        }
    }
}

// ===================== ConsoleApp2 =====================
namespace Lab2.Task2
{

    class Program
    {
        // Повертає true, якщо функцію можна обчислити; результат у y
        static bool TryCalc(double x, out double y)
        {
            y = double.NaN;

            // tg(x) не існує, коли cos(x) = 0 (x = pi/2 + pi*k)
            if (Math.Abs(Math.Cos(x)) < 1e-9)
                return false;

            double under = Math.Tan(x) + 13;

            // корінь парного степеня з від'ємного числа не існує
            if (under < 0)
                return false;

            y = Math.Pow(under, 0.25);
            return true;
        }

        static void PrintRow(double x, double y, bool ok)
        {
            if (ok)
                Console.WriteLine("| {0,10:F5} | {1,14:F6} |", x, y);
            else
                Console.WriteLine("| {0,10:F5} | {1,14} |", x, "не існує");
        }

        public static void Run()
        {
            Console.OutputEncoding = Encoding.UTF8;

            double a = 0, b = Math.PI, dx = Math.PI / 20;
            const double eps = 1e-9;
            double y;
            bool ok;

            Console.WriteLine("Результати обчислення функції y = (tg(x) + 13)^(1/4) на проміжку [0, pi] з кроком pi/20.");

            // ---- Спосіб 1: цикл з передумовою while ----
            Console.WriteLine("\n--- Цикл з передумовою (while) ---");
            Console.WriteLine("|     x      |     y = f(x)   |");
            double x = a;
            while (x <= b + eps)
            {
                ok = TryCalc(x, out y);
                PrintRow(x, y, ok);
                x += dx;
            }

            // ---- Спосіб 2: цикл з післяумовою do...while ----
            Console.WriteLine("\n--- Цикл з післяумовою (do...while) ---");
            Console.WriteLine("|     x      |     y = f(x)   |");
            x = a;
            do
            {
                ok = TryCalc(x, out y);
                PrintRow(x, y, ok);
                x += dx;
            } while (x <= b + eps);

            Console.WriteLine("\nНатисніть будь-яку клавішу...");
            Console.ReadKey();
        }
    }
}

