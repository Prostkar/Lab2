namespace Lab2.Task3
{
    public class Program
    {
        private readonly int[] _data;

        public Program(int[] data)
        {
            _data = data ?? throw new ArgumentNullException(nameof(data));
        }

        public int[] Data => _data;

        // Заповнення масиву псевдовипадковими числами з відрізка [-100; 100]
        public static Program CreateRandom(int n)
        {
            Random rnd = new Random();
            int[] arr = new int[n];
            for (int i = 0; i < n; i++)
                arr[i] = rnd.Next(-100, 101); // верхня межа виключається, тому 101
            return new Program(arr);
        }

        // 1) Кількість нульових елементів
        public int CountZeros()
        {
            int count = 0;
            foreach (int x in _data)
            {
                if (x == 0) count++;
            }
            return count;
        }

        // Індекс першого максимального за модулем елемента
        public int IndexOfMaxAbs()
        {
            if (_data.Length == 0) return -1;

            int idx = 0;
            for (int i = 1; i < _data.Length; i++)
            {
                if (Math.Abs(_data[i]) > Math.Abs(_data[idx]))
                {
                    idx = i;
                }
            }
            return idx;
        }

        // 2) Добуток елементів, розташованих після максимального за модулем елемента
        public bool TryProductAfterMaxAbs(out long product)
        {
            product = 1;
            int idx = IndexOfMaxAbs();

            if (idx == -1 || idx >= _data.Length - 1)
                return false;

            for (int i = idx + 1; i < _data.Length; i++)
            {
                product *= _data[i];
            }
            return true;
        }

        public void Print()
        {
            foreach (int x in _data)
            {
                Console.Write(x + "\t");
            }
            Console.WriteLine();
        }

        // Захист від некоректного введення цілого числа
        static int ReadInt(string message, int min, int max)
        {
            int value;
            while (true)
            {
                Console.Write(message);
                if (int.TryParse(Console.ReadLine(), out value) && value >= min && value <= max)
                    return value;
                Console.WriteLine($"Некоректне значення! Введіть ціле число від {min} до {max}.");
            }
        }

        static void Solve(Program p)
        {
            Console.WriteLine("\nМасив:");
            p.Print();

            Console.WriteLine("1) Кількість нульових елементів: " + p.CountZeros());

            int idx = p.IndexOfMaxAbs();
            if (idx != -1)
            {
                Console.WriteLine($"Максимальний за модулем елемент: {p.Data[idx]} (індекс {idx})");

                if (p.TryProductAfterMaxAbs(out long prod))
                    Console.WriteLine("2) Добуток елементів після максимального за модулем: " + prod);
                else
                    Console.WriteLine("2) Після максимального за модулем елемента немає елементів.");
            }
        }

        // Запитує, чи повторити програму
        static bool AskRepeat()
        {
            while (true)
            {
                Console.Write("\nПовторити? (т - так, н - ні): ");
                string s = (Console.ReadLine() ?? "").Trim().ToLower();
                if (s == "т" || s == "y" || s == "так") return true;
                if (s == "н" || s == "n" || s == "ні") return false;
                Console.WriteLine("Введіть 'т' або 'н'.");
            }
        }

        public static void Run()
        {
            Console.OutputEncoding = Encoding.UTF8;
            Console.InputEncoding = Encoding.UTF8;

            do
            {
                Console.WriteLine("Оберіть спосіб заповнення масиву:");
                Console.WriteLine("  1 - ввести з клавіатури (спосіб А)");
                Console.WriteLine("  2 - згенерувати випадково з відрізка [-100; 100] (спосіб Б)");
                int mode = ReadInt("Ваш вибір (1 або 2): ", 1, 2);

                int n = ReadInt("Введіть кількість елементів масиву n (1-1000): ", 1, 1000);

                if (mode == 1)
                {
                    // ---- Спосіб А: масив вводиться з клавіатури ----
                    Console.WriteLine("\n=== Спосіб А: введення з клавіатури ===");
                    int[] arr = new int[n];
                    for (int i = 0; i < n; i++)
                    {
                        arr[i] = ReadInt($"Введіть елемент a[{i}]: ", int.MinValue, int.MaxValue);
                    }
                    Solve(new Program(arr));
                }
                else
                {
                    // ---- Спосіб Б: генератор випадкових чисел [-100; 100] ----
                    Console.WriteLine("\n=== Спосіб Б: генератор випадкових чисел [-100; 100] ===");
                    Solve(CreateRandom(n));
                }

            } while (AskRepeat());
        }
    }
}

// ===================== ConsoleApp4 =====================
namespace Lab2.Task5
{
    class Program
    {
        // Захист від некоректного введення цілого числа
        static int ReadInt(string message, int min, int max)
        {
            int value;
            while (true)
            {
                Console.Write(message);
                if (int.TryParse(Console.ReadLine(), out value) && value >= min && value <= max)
                    return value;
                Console.WriteLine($"Некоректне значення! Введіть ціле число від {min} до {max}.");
            }
        }

        // Введення матриці з клавіатури
        static int[,] ReadMatrix(int n)
        {
            int[,] a = new int[n, n];
            for (int i = 0; i < n; i++)
                for (int j = 0; j < n; j++)
                    a[i, j] = ReadInt($"Введіть елемент a[{i},{j}] (від -10000 до 10000): ", -10000, 10000);
            return a;
        }

        // Заповнення матриці псевдовипадковими числами з відрізка [-100; 100]
        static int[,] RandomMatrix(int n)
        {
            Random rnd = new Random();
            int[,] a = new int[n, n];
            for (int i = 0; i < n; i++)
                for (int j = 0; j < n; j++)
                    a[i, j] = rnd.Next(-100, 101);
            return a;
        }

        // Перетворення: бічна діагональ (i + j = n - 1) -> 0, інші елементи -> квадрат
        static void Transform(int[,] a)
        {
            int n = a.GetLength(0);
            for (int i = 0; i < n; i++)
                for (int j = 0; j < n; j++)
                {
                    if (i + j == n - 1)
                        a[i, j] = 0;
                    else
                        a[i, j] = a[i, j] * a[i, j];
                }
        }

        static void Print(int[,] a, string title)
        {
            Console.WriteLine(title);
            int n = a.GetLength(0);
            for (int i = 0; i < n; i++)
            {
                for (int j = 0; j < n; j++)
                    Console.Write(a[i, j].ToString().PadLeft(8));
                Console.WriteLine();
            }
        }

        static void Solve(int[,] a)
        {
            Print(a, "\nПочаткова матриця:");
            Transform(a);
            Print(a, "\nМатриця після перетворення:");
        }

        // Запитує, чи повторити програму
        static bool AskRepeat()
        {
            while (true)
            {
                Console.Write("\nПовторити? (т - так, н - ні): ");
                string s = (Console.ReadLine() ?? "").Trim().ToLower();
                if (s == "т" || s == "y" || s == "так") return true;
                if (s == "н" || s == "n" || s == "ні") return false;
                Console.WriteLine("Введіть 'т' або 'н'.");
            }
        }

        public static void Run()
        {
            Console.OutputEncoding = Encoding.UTF8;
            Console.InputEncoding = Encoding.UTF8;

            do
            {
                Console.WriteLine("Оберіть спосіб заповнення матриці:");
                Console.WriteLine("  1 - ввести з клавіатури");
                Console.WriteLine("  2 - згенерувати випадково з відрізка [-100; 100]");
                int mode = ReadInt("Ваш вибір (1 або 2): ", 1, 2);

                int n = ReadInt("Введіть розмірність квадратної матриці n (1-10): ", 1, 10);

                if (mode == 1)
                {
                    Console.WriteLine("\n=== Введення з клавіатури ===");
                    Solve(ReadMatrix(n));
                }
                else
                {
                    Console.WriteLine("\n=== Генератор псевдовипадкових чисел [-100; 100] ===");
                    Solve(RandomMatrix(n));
                }
            } while (AskRepeat());
        }
    }
}
